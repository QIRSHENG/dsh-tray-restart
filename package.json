{
  "name": "dsh-tray-restart",
  "version": "1.2.0",
  "description": "Adds Restart, Reload Page and Force Quit items to the DeepSeek Harness desktop system-tray menu, and re-applies the patch after every app update.",
  "type": "module",
  "license": "MIT",
  "author": "QIRSHENG",
  "homepage": "https://github.com/QIRSHENG/dsh-tray-restart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIRSHENG/dsh-tray-restart.git"
  },
  "bugs": {
    "url": "https://github.com/QIRSHENG/dsh-tray-restart/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tray",
    "reload",
    "restart",
    "windows"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/patcher.mjs",
    "quit-all.ps1",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
